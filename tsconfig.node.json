{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "packages/**/*.ts",
    "apps/desktop/electron/**/*.ts",
    "apps/desktop/electron.vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["**/node_modules", "**/dist", "**/out"]
}
